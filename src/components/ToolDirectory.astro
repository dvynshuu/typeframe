---
import { toolsData } from '../data/tools';

interface Props {
  currentSlug?: string;
  heading?: string;
}

const { currentSlug, heading = 'Studios by format' } = Astro.props;
---

<section class="directory" id="studios" aria-labelledby="tool-directory-heading">
  <div class="directory__head">
    <div>
      <h2 id="tool-directory-heading" class="directory__title">{heading}</h2>
      <p class="directory__note">Each studio opens with a matching canvas, typeface, and surface.</p>
    </div>
    <span class="directory__count">{String(toolsData.length).padStart(2, '0')} formats</span>
  </div>

  <div class="directory__grid">
    {toolsData.map((tool, index) => {
      const isCurrent = currentSlug === tool.slug;
      return (
        <a
          href={`/tools/${tool.slug}/`}
          class="directory__item"
          aria-current={isCurrent ? 'page' : undefined}
        >
          <span class="directory__index">{String(index + 1).padStart(2, '0')}</span>
          <span>
            <span class="directory__name">{tool.h1}</span>
            <span class="directory__summary">{tool.summary}</span>
          </span>
          <span class="directory__meta">{isCurrent ? 'Open' : tool.category}</span>
        </a>
      );
    })}
  </div>
</section>
