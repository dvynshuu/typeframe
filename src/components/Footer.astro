---
import { toolsData } from '../data/tools';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-wordmark" aria-label="Typeframe home">
          <span class="footer-mark" aria-hidden="true">T</span>
          <span>Typeframe</span>
        </a>
        <p class="footer-note">
          A typographic studio for words that deserve better than a screenshot.
          Type, surface, and export are composed locally in your browser.
        </p>
        <p class="footer-fineprint">No accounts. No uploads. No watermark.</p>
      </div>

      <nav class="footer-columns" aria-label="Footer">
        <div class="footer-col">
          <h2 class="footer-heading">Studios</h2>
          <ul class="footer-list">
            {toolsData.slice(0, 4).map((tool) => (
              <li><a href={`/tools/${tool.slug}/`}>{tool.h1}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">More formats</h2>
          <ul class="footer-list">
            {toolsData.slice(4).map((tool) => (
              <li><a href={`/tools/${tool.slug}/`}>{tool.h1}</a></li>
            ))}
            <li><a href="/#typeframe-editor">Full canvas studio</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Studio</h2>
          <ul class="footer-list">
            <li><a href="/#guide">Guide</a></li>
            <li><a href="/#studios">All studios</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-heading">Legal</h2>
          <ul class="footer-list">
            <li><a href="/privacy-policy/">Privacy policy</a></li>
            <li><a href="/terms/">Terms of service</a></li>
            <li><a href="mailto:support@typeframe.pages.dev">support@<wbr />typeframe.pages.dev</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Typeframe. Exports belong to their creators.</p>
      <p class="footer-set">Set in Inter, Instrument Serif, and JetBrains Mono.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-hairline);
    background: var(--bg-app);
    color: var(--text-muted);
    position: relative;
    z-index: 10;
  }

  .footer-inner {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--page-pad) 1.75rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-bottom: clamp(2.25rem, 5vw, 3.25rem);
  }

  .footer-brand {
    max-width: 30ch;
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
  }

  .footer-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding-bottom: 2px;
    border: 1px solid var(--border-soft);
    border-radius: 3px;
    color: var(--accent-bright);
    font-size: 1rem;
  }

  .footer-note {
    margin: 1rem 0 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .footer-fineprint {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.35fr);
    gap: 1.5rem;
  }

  .footer-heading {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-list a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
    transition: color 150ms var(--ease-out);
  }

  .footer-list a:hover {
    color: var(--accent-bright);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-hairline);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-set {
    text-align: right;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-set {
      text-align: left;
    }
  }
</style>
