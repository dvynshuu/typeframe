---
import '../styles/editor.css';
import { templates, presetSizes } from '../lib/templates';
import { themes } from '../lib/themes';
import { fontFamilies, fontWeights } from '../lib/typography';
import { aspectLabel } from '../utils/aspect';
import type { ToolConfig } from '../data/tools';

interface Props {
  initialTool?: ToolConfig;
}

const { initialTool } = Astro.props;
---

<div
  class="app-shell"
  id="typeframe-editor"
  data-tool-slug={initialTool?.slug}
  data-initial-template={initialTool?.templateId}
  data-initial-theme={initialTool?.themeId}
  data-initial-mode={initialTool?.textMode}
  data-initial-text={initialTool?.defaultText ? encodeURIComponent(initialTool.defaultText) : undefined}
  data-mobile-view="compose"
>
  <header class="app-header">
    <div class="app-brand">
      <a href="/" class="app-brand-link" aria-label="Typeframe home">
        <span class="app-logo-mark" aria-hidden="true">T</span>
        <span class="app-logo-text">Typeframe</span>
      </a>
      {initialTool ? (
        <h1 class="header-tool-badge__title">{initialTool.h1}</h1>
      ) : (
        <>
          <h1 class="sr-only">Typeframe — typographic studio for shareable images</h1>
          <p class="app-tagline">Typography studio for shareable images</p>
        </>
      )}
    </div>

    <nav class="header-nav-menu" aria-label="Primary">
      <a href="/#studios" class="header-nav-anchor">Studios</a>
      <a href="/#guide" class="header-nav-anchor">Guide</a>
      <a href="/about/" class="header-nav-anchor">About</a>
      <a href="/contact/" class="header-nav-anchor">Contact</a>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="icon-button has-tooltip"
        id="copy-img-btn"
        data-tooltip="Copy image"
        aria-label="Copy rendered image to clipboard"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>

      <button type="button" class="btn-secondary" id="share-btn" aria-label="Copy a shareable link to this design">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
        <span class="btn-secondary__text">Share</span>
      </button>

      <div class="export-cluster" role="group" aria-label="Export settings">
        <label class="sr-only" for="export-format">Export format</label>
        <select id="export-format" class="export-select">
          <option value="png">PNG</option>
          <option value="jpeg">JPG</option>
          <option value="webp">WebP</option>
          <option value="svg">SVG</option>
        </select>
        <label class="sr-only" for="export-scale">Export resolution</label>
        <select id="export-scale" class="export-select">
          <option value="1">1×</option>
          <option value="2" selected>2×</option>
          <option value="4">4×</option>
        </select>
        <button type="button" class="btn-export" id="export-btn" title="Export image (Ctrl+Enter)">
          <span class="btn-export__text">Export</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile studio controller -->
  <nav class="mobile-studio-nav" aria-label="Studio sections" role="tablist">
    <button type="button" class="mobile-nav-tab is-active" data-view="compose" role="tab" aria-selected="true" aria-controls="panel-compose">
      Write
    </button>
    <button type="button" class="mobile-nav-tab" data-view="artboard" role="tab" aria-selected="false" aria-controls="preview-stage">
      Artboard
    </button>
    <button type="button" class="mobile-nav-tab" data-view="style" role="tab" aria-selected="false" aria-controls="panel-style">
      Style
    </button>
  </nav>

  <aside class="panel panel--left" id="panel-compose">
    <div class="panel-rail">
      <div>
        <span class="panel-rail__label">Step 01</span>
        <h2 class="panel-rail__title">Compose</h2>
      </div>
      <button type="button" class="rail-action has-tooltip" id="shuffle-btn" data-tooltip="Randomize type and surface" aria-label="Randomize type, layout and surface">
        Shuffle
      </button>
    </div>
    <div class="panel-body">
      <details class="panel-section" open>
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Words</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="mode-tabs" role="tablist" aria-label="Text mode">
            <button type="button" data-mode="plain" class="is-active" role="tab" aria-selected="true">Plain</button>
            <button type="button" data-mode="rich" role="tab" aria-selected="false">Rich</button>
            <button type="button" data-mode="markdown" role="tab" aria-selected="false">Markdown</button>
          </div>
          <div class="compose-editor">
            <div class="editor-formatting-toolbar" id="formatting-toolbar" role="toolbar" aria-label="Text formatting">
              <button type="button" data-action="bold" title="Bold (Ctrl+B)">B</button>
              <button type="button" data-action="italic" title="Italic (Ctrl+I)">I</button>
              <button type="button" data-action="heading" title="Heading (Ctrl+H)">H</button>
              <div class="toolbar-color-picker-wrapper">
                <button type="button" class="toolbar-color-btn" title="Text color" id="text-color-btn" aria-label="Choose text color">
                  <span class="color-icon-letter" aria-hidden="true">A</span>
                  <span class="color-icon-indicator" id="text-color-indicator"></span>
                </button>
                <input type="color" id="text-color" class="sr-only" value="#f2efe9" tabindex="-1" aria-hidden="true" />
              </div>
            </div>
            <textarea
              id="text-input"
              placeholder="Type a quote, headline, or thread…"
              aria-label="Image text content"
            >Design is not just what it looks like.
Design is how it works.</textarea>
          </div>
          <p class="compose-hint">
            Markdown: <kbd>**bold**</kbd> <kbd>*italic*</kbd> <kbd># heading</kbd>
          </p>
        </div>
      </details>

      <details class="panel-section" open>
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Format</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="template-grid" role="list">
            {templates.map((t) => (
              <button
                type="button"
                role="listitem"
                class:list={['template-chip', { 'is-active': t.id === 'quote-card' }]}
                data-template={t.id}
                aria-pressed={t.id === 'quote-card' ? 'true' : 'false'}
              >
                <span class="template-chip__name">{t.name}</span>
                <span class="template-chip__ratio">{aspectLabel(t.width, t.height)}</span>
              </button>
            ))}
          </div>
        </div>
      </details>

      <details class="panel-section" open>
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Atmosphere</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="theme-grid">
            {themes.map((t) => (
              <button
                type="button"
                class:list={['theme-tile', { 'is-active': t.id === 'studio-dark' }]}
                data-theme={t.id}
                title={t.tagline}
                aria-pressed={t.id === 'studio-dark' ? 'true' : 'false'}
              >
                <span class="theme-tile__swatch" style={`background: ${t.swatch}`} aria-hidden="true" />
                <span class="theme-tile__name">{t.name}</span>
              </button>
            ))}
          </div>
        </div>
      </details>
    </div>
  </aside>

  <main class="preview-stage" id="preview-stage">
    <div class="preview-toolbar">
      <span class="preview-toolbar__label">Artboard</span>
      <span class="preview-toolbar__size" id="preview-size-label">1080 × 1080</span>
      <span class="preview-toolbar__hint">Drag to reposition</span>
    </div>
    <div class="mobile-artboard-shortcuts">
      <button type="button" class="btn-jump-tab" data-jump="compose">Edit words</button>
      <button type="button" class="btn-jump-tab" data-jump="style">Adjust style</button>
    </div>
    <div class="preview-stage__glow" aria-hidden="true"></div>
    <div class="preview-viewport">
      <div class="preview-frame">
        <div class="preview-frame__corners" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="preview-wrapper" id="preview-wrapper">
          <canvas
            id="preview-canvas"
            class="preview-canvas"
            role="img"
            aria-label="Live typographic image preview"
          ></canvas>
          <div class="preview-guides" aria-hidden="true"></div>
          <div id="handles-layer"></div>
        </div>
      </div>
    </div>
  </main>

  <aside class="panel panel--right" id="panel-style">
    <div class="panel-rail">
      <span class="panel-rail__label">Step 02</span>
      <h2 class="panel-rail__title">Refine</h2>
    </div>
    <div class="panel-body">
      <details class="panel-section" open>
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Typography</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="field">
            <label for="font-family">Typeface</label>
            <select id="font-family">
              {fontFamilies.map((f) => (
                <option value={f.value}>{f.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="font-weight">Weight</label>
            <select id="font-weight">
              {fontWeights.map((w) => (
                <option value={w.value}>{w.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="font-size">
              Size <span class="field__value" id="font-size-val">42</span>
            </label>
            <input type="range" id="font-size" min="12" max="96" value="42" aria-valuetext="42 pixels" />
          </div>
          <div class="field">
            <label for="line-height">
              Leading <span class="field__value" id="line-height-val">1.4</span>
            </label>
            <input type="range" id="line-height" min="1" max="2.5" step="0.05" value="1.4" />
          </div>
          <div class="field">
            <label for="letter-spacing">
              Tracking <span class="field__value" id="letter-spacing-val">0</span>
            </label>
            <input type="range" id="letter-spacing" min="-0.05" max="0.2" step="0.01" value="0" />
          </div>
          <div class="field">
            <span class="field__label">Alignment</span>
            <div class="align-bar" role="group" aria-label="Text alignment">
              <button type="button" data-align="left" title="Align left" aria-label="Align left" aria-pressed="false">Left</button>
              <button type="button" data-align="center" class="is-active" title="Align center" aria-label="Align center" aria-pressed="true">Center</button>
              <button type="button" data-align="right" title="Align right" aria-label="Align right" aria-pressed="false">Right</button>
            </div>
            <select id="text-align" class="sr-only" tabindex="-1" aria-hidden="true">
              <option value="left">Left</option>
              <option value="center" selected>Center</option>
              <option value="right">Right</option>
            </select>
          </div>
        </div>
      </details>

      <details class="panel-section" open>
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Surface</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="field">
            <span class="field__label">Curated swatches</span>
            <div class="presets-gallery">
              <button type="button" class="preset-swatch" data-preset="ink-mesh" title="Ink Wash" aria-label="Ink Wash" style="background: radial-gradient(circle at 25% 25%, #5a3428, #0a0a0c);"></button>
              <button type="button" class="preset-swatch" data-preset="amber-dusk" title="Amber Dusk" aria-label="Amber Dusk" style="background: linear-gradient(135deg, #d96a3b, #f0b27a);"></button>
              <button type="button" class="preset-swatch" data-preset="press-black" title="Press Black" aria-label="Press Black" style="background: #121214; border: 1px dashed rgba(242,239,233,0.3);"></button>
              <button type="button" class="preset-swatch" data-preset="frosted-glass" title="Frosted Glass" aria-label="Frosted Glass" style="background: linear-gradient(135deg, #2a2a2e, #18181b); border: 1.5px solid rgba(242,239,233,0.35);"></button>
              <button type="button" class="preset-swatch" data-preset="ink-grain" title="Ink Grain" aria-label="Ink Grain" style="background: #0a0a0c; border: 1px solid rgba(242,239,233,0.1);"></button>
              <button type="button" class="preset-swatch" data-preset="paper" title="Paper" aria-label="Paper" style="background: #f5f1e8; border: 1px solid #ccc;"></button>
              <button type="button" class="preset-swatch" data-preset="cinnabar-mesh" title="Cinnabar" aria-label="Cinnabar" style="background: radial-gradient(circle at 80% 80%, #ff5a36, #24100a);"></button>
            </div>
          </div>
          <div class="field">
            <label for="bg-type">Background</label>
            <select id="bg-type">
              <option value="solid">Solid</option>
              <option value="gradient">Gradient</option>
              <option value="mesh">Mesh</option>
              <option value="glass">Glass</option>
              <option value="noise">Grain</option>
              <option value="image">Photo upload</option>
            </select>
          </div>
          <div class="field">
            <label for="solid-color">Fill color</label>
            <input type="color" id="solid-color" value="#0f0f12" />
          </div>
          <div class="field">
            <label for="bg-upload">Background image</label>
            <input type="file" id="bg-upload" accept="image/*" />
          </div>
          <div id="image-controls-group" class="field-group" hidden>
            <div class="field">
              <label for="bg-image-size">Size mode</label>
              <select id="bg-image-size">
                <option value="cover">Cover (fill)</option>
                <option value="contain">Contain (fit)</option>
                <option value="stretch">Stretch</option>
                <option value="original">Original</option>
              </select>
            </div>
            <div class="field">
              <label for="bg-image-scale">
                Zoom <span class="field__value" id="bg-image-scale-val">100%</span>
              </label>
              <input type="range" id="bg-image-scale" min="10" max="300" value="100" />
            </div>
            <div class="field">
              <label for="bg-image-opacity">
                Opacity <span class="field__value" id="bg-image-opacity-val">90%</span>
              </label>
              <input type="range" id="bg-image-opacity" min="0" max="100" value="90" />
            </div>
          </div>
          <div class="field field--checkbox">
            <label class="checkbox-control" for="show-masthead-toggle">
              <input type="checkbox" id="show-masthead-toggle" />
              <span class="checkbox-text">Discreet creator mark</span>
            </label>
          </div>
        </div>
      </details>

      <details class="panel-section">
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Studio frame</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="field">
            <span class="field__label">Frame style</span>
            <div class="frame-style-grid" role="group" aria-label="Studio frame style">
              <button type="button" class="frame-style-btn is-active" data-frame="none" aria-pressed="true">None</button>
              <button type="button" class="frame-style-btn" data-frame="macos" aria-pressed="false">macOS</button>
              <button type="button" class="frame-style-btn" data-frame="glass" aria-pressed="false">Glass</button>
              <button type="button" class="frame-style-btn" data-frame="browser" aria-pressed="false">Browser</button>
              <button type="button" class="frame-style-btn" data-frame="tweet" aria-pressed="false">Tweet</button>
              <button type="button" class="frame-style-btn" data-frame="editorial" aria-pressed="false">Editorial</button>
            </div>
          </div>

          <div id="frame-options-group" class="field-group" hidden>
            <div class="field">
              <label for="card-padding">
                Card margin <span class="field__value" id="card-padding-val">56px</span>
              </label>
              <input type="range" id="card-padding" min="16" max="120" step="4" value="56" />
            </div>
            <div class="field">
              <label for="card-radius">
                Corner radius <span class="field__value" id="card-radius-val">16px</span>
              </label>
              <input type="range" id="card-radius" min="0" max="36" step="2" value="16" />
            </div>
            <div class="field">
              <label for="card-shadow">Shadow depth</label>
              <select id="card-shadow">
                <option value="none">None (flat)</option>
                <option value="subtle">Subtle soft</option>
                <option value="float" selected>Studio float</option>
                <option value="glow">Neon glow</option>
              </select>
            </div>
          </div>

          <div class="field field--author">
            <div class="field field--checkbox">
              <label class="checkbox-control" for="author-signature-toggle">
                <input type="checkbox" id="author-signature-toggle" />
                <span class="checkbox-text">Show author attribution</span>
              </label>
            </div>
            <div id="author-inputs-group" class="author-inputs-group" hidden>
              <div class="field field--row author-name-row">
                <div>
                  <label for="author-name">Name</label>
                  <input type="text" id="author-name" placeholder="Alex Rivera" value="Alex Rivera" />
                </div>
                <div>
                  <label for="author-handle">Handle</label>
                  <input type="text" id="author-handle" placeholder="@arivera" value="@arivera" />
                </div>
              </div>
              <div class="field field--checkbox">
                <label class="checkbox-control" for="author-verified-toggle">
                  <input type="checkbox" id="author-verified-toggle" checked />
                  <span class="checkbox-text">Verified badge</span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </details>

      <details class="panel-section">
        <summary class="panel-section__head">
          <h3 class="panel-section__title">Dimensions</h3>
          <span class="panel-section__line" aria-hidden="true"></span>
        </summary>
        <div class="panel-section__body">
          <div class="field">
            <label for="preset-size">Preset</label>
            <select id="preset-size">
              {presetSizes.map((p) => (
                <option value={p.id}>{p.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <div class="dimensions-lock-row">
              <span class="custom-size-label">Custom size</span>
              <button type="button" class="btn-lock-ratio" id="lock-ratio-btn" title="Lock aspect ratio" aria-pressed="false">
                <span class="lock-icon" aria-hidden="true"></span>
                <span class="lock-text">Unlocked</span>
              </button>
            </div>
            <div class="field field--row">
              <div>
                <label for="custom-width">Width</label>
                <input type="number" id="custom-width" min="400" max="4096" value="1080" />
              </div>
              <div>
                <label for="custom-height">Height</label>
                <input type="number" id="custom-height" min="400" max="4096" value="1080" />
              </div>
            </div>
          </div>
        </div>
      </details>
    </div>
  </aside>

  <div id="sr-preview-description" class="sr-only" aria-live="polite"></div>
</div>
