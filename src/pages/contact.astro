---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Contact — Typeframe';
const pageDescription =
  'Contact Typeframe for support, bug reports, licensing questions, or typeface suggestions. Direct email, no contact form, usually answered within two working days.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  url="https://typeframe.pages.dev/contact/"
>
  <main class="page">
    <div class="prose-wrap">
      <header class="prose-header">
        <p class="page-kicker">Contact</p>
        <h1 class="prose-title">Say what broke.</h1>
        <p class="page-lead">
          Typeframe is maintained by one person, so direct email is faster than a
          contact form. A browser, an export format, and a reliable set of steps
          are the most useful things you can include.
        </p>
        <p class="prose-meta">Replies usually within two working days</p>
      </header>

      <div class="contact-list">
        <div class="contact-item">
          <p class="contact-item__label">Email</p>
          <div>
            <h2 class="contact-item__title">Support and general questions</h2>
            <p class="contact-item__body">
              Licensing, privacy, export problems, or anything that does not fit
              the categories below.
            </p>
            <a class="contact-item__link" href="mailto:support@typeframe.pages.dev">support@typeframe.pages.dev</a>
          </div>
        </div>

        <div class="contact-item">
          <p class="contact-item__label">Bugs</p>
          <div>
            <h2 class="contact-item__title">Report a rendering problem</h2>
            <p class="contact-item__body">
              Include the browser, operating system, export format, and the steps
              that reproduce the issue. A screenshot or the shared design URL
              helps more than a description alone.
            </p>
            <a class="contact-item__link" href="mailto:support@typeframe.pages.dev?subject=Typeframe%20bug%20report">Email a bug report</a>
          </div>
        </div>

        <div class="contact-item">
          <p class="contact-item__label">Elsewhere</p>
          <div>
            <h2 class="contact-item__title">Follow development</h2>
            <p class="contact-item__body">
              New formats, typeface additions, and fixes are posted as they ship.
            </p>
            <a class="contact-item__link" href="https://x.com/dvynshuu" target="_blank" rel="noopener noreferrer">@dvynshuu on X</a>
          </div>
        </div>
      </div>

      <section class="contact-faq" aria-labelledby="contact-faq-title">
        <h2 class="section-title" id="contact-faq-title">Before you write</h2>

        <div class="faq-list">
          <details class="faq-item" open>
            <summary>Can I use exports commercially?</summary>
            <div class="faq-body">
              <p>
                Yes. Typeframe claims no ownership over your exports and adds no
                watermark. You are responsible for the rights to any text,
                quotations, or photographs you use.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary>Do you keep my text or photos?</summary>
            <div class="faq-body">
              <p>
                No. The editor runs in your browser and the site has no upload
                endpoint. Text, settings, and background images stay on your
                device. The <a href="/privacy-policy/">privacy policy</a> explains
                the details.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary>Why is there no contact form?</summary>
            <div class="faq-body">
              <p>
                A form needs a server to receive and store submissions. Typeframe
                is a static site, so email keeps the footprint smaller and the
                conversation direct.
              </p>
            </div>
          </details>

          <details class="faq-item">
            <summary>Can I request a typeface or format?</summary>
            <div class="faq-body">
              <p>
                Yes. Send the use case rather than only the name of the font.
                Requests are considered against the existing set, and not every
                one can be accommodated.
              </p>
            </div>
          </details>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
