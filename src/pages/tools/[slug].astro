---
// src/pages/tools/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Editor from '../../components/Editor.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import Footer from '../../components/Footer.astro';
import { toolsData, type ToolConfig } from '../../data/tools';

export function getStaticPaths() {
  return toolsData.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;
const index = toolsData.findIndex((entry) => entry.slug === tool.slug);
const studioNumber = String(index + 1).padStart(2, '0');
const pageUrl = `https://typeframe.pages.dev/tools/${tool.slug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `Typeframe — ${tool.h1}`,
  description: tool.metaDescription,
  url: pageUrl,
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any',
  browserRequirements:
    'A modern browser with HTML5 Canvas, JavaScript, and local storage.',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: tool.highlightFeatures,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Typeframe',
      item: 'https://typeframe.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Studios',
      item: 'https://typeframe.pages.dev/#studios',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: tool.h1,
      item: pageUrl,
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={tool.metaTitle}
  description={tool.metaDescription}
  url={pageUrl}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
  faqJsonLd={faqJsonLd}
>
  <Editor initialTool={tool} />

  <main class="page">
    <div class="page-wrap">
      <header class="tool-intro">
        <div class="tool-intro__meta">
          <p class="page-kicker">Studio {studioNumber} — {tool.category}</p>
          <a class="tool-intro__back" href="/#studios">All studios</a>
        </div>
        <h2 class="page-title tool-intro__title">{tool.headline}</h2>
        <p class="page-lead">{tool.summary}</p>
        <div class="page-actions">
          <a class="btn-solid" href="#typeframe-editor">Start composing</a>
          <a class="btn-ghost" href="/#guide">Read the guide</a>
        </div>
      </header>

      <section class="page-section" aria-labelledby="capabilities-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Capabilities</p>
            <h2 class="section-title" id="capabilities-title">What this studio does.</h2>
          </div>
          <p class="section-note">
            The canvas above is the whole tool. These are the parts of it this
            format leans on; nothing is held back for a paid plan.
          </p>
        </div>

        <ol class="feature-list">
          {tool.highlightFeatures.map((feature, featureIndex) => (
            <li class="feature-list__item">
              <span class="feature-list__index">{String(featureIndex + 1).padStart(2, '0')}</span>
              <span class="feature-list__text">{feature}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="page-section" id="faq" aria-labelledby="faq-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Questions</p>
            <h2 class="section-title" id="faq-title">Practical answers.</h2>
          </div>
          <p class="section-note">
            Each answer describes the current build, not a roadmap.
          </p>
        </div>

        <div class="faq-list">
          {tool.faqs.map((faq, faqIndex) => (
            <details class="faq-item" open={faqIndex === 0}>
              <summary>{faq.question}</summary>
              <div class="faq-body"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>

  <ToolDirectory currentSlug={tool.slug} heading="Other studios" />
  <Footer />

  <script>
    import { initEditor } from '../../components/EditorApp';

    const boot = () => {
      const root = document.getElementById('typeframe-editor');
      if (root) initEditor(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  </script>
</BaseLayout>
