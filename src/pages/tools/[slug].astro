---
// src/pages/tools/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Editor from '../../components/Editor.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { toolsData, type ToolConfig } from '../../data/tools';

export function getStaticPaths() {
  return toolsData.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;
const pageUrl = `https://typeframe.pages.dev/tools/${tool.slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `Typeframe — ${tool.h1}`,
  "description": tool.metaDescription,
  "url": pageUrl,
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires a modern web browser with HTML5 Canvas and Javascript enabled.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": tool.highlightFeatures
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<BaseLayout 
  title={tool.metaTitle} 
  description={tool.metaDescription} 
  url={pageUrl}
  keywords={tool.keywords}
  jsonLd={jsonLd}
  faqJsonLd={faqJsonLd}
>
  <Editor initialTool={tool} />

  <!-- Semantic, crawlable SEO article providing rich context & FAQ for search indexing -->
  <section class="tool-seo-landing" aria-label={`${tool.h1} Guide & FAQs`}>
    <div class="tool-seo-container">
      <header class="tool-seo-header">
        <span class="tool-seo-badge">{tool.badge}</span>
        <h1 class="tool-seo-title">{tool.h1}</h1>
        <p class="tool-seo-lead">{tool.summary}</p>
      </header>

      <div class="tool-seo-highlights">
        <h2 class="tool-seo-subheading">Studio Capabilities & Advantages</h2>
        <div class="highlights-grid">
          {tool.highlightFeatures.map((feature) => (
            <div class="highlight-item">
              <span class="highlight-icon" aria-hidden="true">✓</span>
              <span class="highlight-text">{feature}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="tool-seo-faqs">
        <h2 class="tool-seo-subheading">Frequently Asked Questions</h2>
        <div class="faq-list">
          {tool.faqs.map((faq) => (
            <details class="tool-faq-detail" open>
              <summary class="tool-faq-summary">{faq.question}</summary>
              <div class="tool-faq-body">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>

      <ToolDirectory currentSlug={tool.slug} variant="grid" />
    </div>
  </section>

  <script>
    import { initEditor } from '../../components/EditorApp';

    const boot = () => {
      const root = document.getElementById('typeframe-editor');
      if (root) initEditor(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  </script>
</BaseLayout>

<style>
  .tool-seo-landing {
    background: #080a0f;
    border-top: 1px solid rgba(232, 236, 244, 0.08);
    padding: 4.5rem 1.5rem 6rem;
    position: relative;
    z-index: 10;
  }

  .tool-seo-container {
    max-width: 1040px;
    margin: 0 auto;
  }

  .tool-seo-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .tool-seo-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6e8cff;
    background: rgba(110, 140, 255, 0.1);
    border: 1px solid rgba(110, 140, 255, 0.25);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .tool-seo-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #f1f3f9;
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .tool-seo-lead {
    font-size: 1.125rem;
    color: #94a1b5;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tool-seo-subheading {
    font-size: 1.45rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .tool-seo-highlights {
    margin-bottom: 4rem;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }

  @media (max-width: 600px) {
    .tool-seo-landing {
      padding: 3rem 1rem 4rem;
    }
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.2rem;
    background: rgba(15, 18, 26, 0.6);
    border: 1px solid rgba(232, 236, 244, 0.08);
    border-radius: 12px;
  }

  .highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(110, 140, 255, 0.2);
    color: #6e8cff;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .highlight-text {
    font-size: 0.92rem;
    color: #c9d2e0;
    line-height: 1.5;
  }

  .tool-seo-faqs {
    margin-bottom: 4.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tool-faq-detail {
    background: rgba(15, 18, 26, 0.7);
    border: 1px solid rgba(232, 236, 244, 0.08);
    border-radius: 12px;
    padding: 1.15rem 1.4rem;
    transition: border-color 0.2s ease;
  }

  .tool-faq-detail:hover {
    border-color: rgba(110, 140, 255, 0.3);
  }

  .tool-faq-summary {
    font-size: 1.02rem;
    font-weight: 600;
    color: #f1f3f9;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .tool-faq-summary::-webkit-details-marker {
    display: none;
  }

  .tool-faq-summary::after {
    content: '+';
    font-size: 1.25rem;
    color: #6e8cff;
    transition: transform 0.2s ease;
  }

  .tool-faq-detail[open] .tool-faq-summary::after {
    content: '−';
    transform: rotate(180deg);
  }

  .tool-faq-body {
    margin-top: 0.85rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #8f9ba9;
  }
</style>
