---
import BaseLayout from '../layouts/BaseLayout.astro';
import Editor from '../components/Editor.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
---

<BaseLayout>
  <Editor />
  
  <aside class="home-tool-directory-wrapper" aria-label="Explore Studios">
    <ToolDirectory variant="grid" />
  </aside>

  <script>
    import { initEditor } from '../components/EditorApp';

    const boot = () => {
      const root = document.getElementById('typeframe-editor');
      if (root) initEditor(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  </script>
</BaseLayout>

<style>
  .home-tool-directory-wrapper {
    background: #080a0f;
    border-top: 1px solid rgba(232, 236, 244, 0.08);
    padding: 3rem 1.5rem 5rem;
    position: relative;
    z-index: 10;
  }

  @media (max-width: 600px) {
    .home-tool-directory-wrapper {
      padding: 2rem 1rem 3.5rem;
    }
  }
</style>
