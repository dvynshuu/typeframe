---
import BaseLayout from '../layouts/BaseLayout.astro';
import Editor from '../components/Editor.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
import Footer from '../components/Footer.astro';
import { homeFaqs, homeFaqJsonLd } from '../data/home-faqs';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Typeframe',
  url: 'https://typeframe.pages.dev/',
  description:
    'A browser-based typographic studio for turning quotes, code, notes, and posts into editorial images.',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any',
  browserRequirements: 'A modern browser with HTML5 Canvas, JavaScript, and local storage.',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Live canvas editor with drag-to-position text',
    'Seven self-hosted typefaces',
    'Solid, gradient, mesh, glass, grain, and photo surfaces',
    'PNG, JPEG, WebP, and SVG export up to 4×',
  ],
};
---

<BaseLayout description="Set quotes, code, notes, or posts in editorial type. Typeframe is a free, private typographic studio with instant PNG, WebP, JPEG, and SVG export." jsonLd={jsonLd} faqJsonLd={homeFaqJsonLd}>
  <Editor />

  <main class="page">
    <div class="page-wrap">
      <section class="page-section" id="guide" aria-labelledby="guide-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Guide</p>
            <h2 class="section-title" id="guide-title">Set the words.<br />Choose the weather.</h2>
          </div>
          <p class="section-note">
            Typeframe is a single-purpose composition tool. There is no dashboard,
            no template marketplace, and no account. The canvas is the product.
          </p>
        </div>

        <ol class="guide-steps">
          <li class="guide-step">
            <span class="guide-step__index">01 — Write</span>
            <h3 class="guide-step__title">Put the text on the artboard</h3>
            <p class="guide-step__body">
              Type or paste a quote, a code fence, a short note, or a set of bullet
              points. Plain, rich, and Markdown modes are available; the preview
              updates as you edit.
            </p>
          </li>
          <li class="guide-step">
            <span class="guide-step__index">02 — Compose</span>
            <h3 class="guide-step__title">Set the type and the surface</h3>
            <p class="guide-step__body">
              Choose a typeface and weight, adjust size, leading, and tracking,
              then pick a ratio and a surface. Text blocks can be dragged or
              nudged into place.
            </p>
          </li>
          <li class="guide-step">
            <span class="guide-step__index">03 — Export</span>
            <h3 class="guide-step__title">Take the image with you</h3>
            <p class="guide-step__body">
              Export a PNG, JPEG, WebP, or SVG at up to 4× the canvas size, or copy
              a PNG straight to the clipboard. Nothing is queued on a server.
            </p>
          </li>
        </ol>
      </section>

      <section class="page-section" aria-labelledby="formats-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Formats</p>
            <h2 class="section-title" id="formats-title">One canvas, several registers.</h2>
          </div>
          <p class="section-note">
            The same editing surface adapts to the shape of the thought. Start
            anywhere and change format later.
          </p>
        </div>

        <dl class="row-list">
          <div class="row-list__item">
            <dt class="row-list__term">Quotes</dt>
            <dd class="row-list__desc">
              A line worth keeping, set in a serif with room around it. Square
              and portrait ratios are both available.
            </dd>
          </div>
          <div class="row-list__item">
            <dt class="row-list__term">Code</dt>
            <dd class="row-list__desc">
              Short snippets in JetBrains Mono, with line-by-line colour and an
              optional window or browser frame.
            </dd>
          </div>
          <div class="row-list__item">
            <dt class="row-list__term">Notes</dt>
            <dd class="row-list__desc">
              Warm paper, simple type, and enough leading for lists, definitions,
              and study summaries that need to stay readable.
            </dd>
          </div>
          <div class="row-list__item">
            <dt class="row-list__term">Posts</dt>
            <dd class="row-list__desc">
              Landscape and square cards for timelines and feeds, with optional
              author attribution and a verification mark.
            </dd>
          </div>
          <div class="row-list__item">
            <dt class="row-list__term">Stories</dt>
            <dd class="row-list__desc">
              A full 1080 × 1920 canvas for vertical placements, with the
              composition centred and controls kept clear of the edges.
            </dd>
          </div>
        </dl>
      </section>

      <section class="page-section" aria-labelledby="privacy-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Under the hood</p>
            <h2 class="section-title" id="privacy-title">Local by construction.</h2>
          </div>
          <p class="section-note">
            Typeframe is a static site. There is no application server holding
            your drafts, and no upload endpoint for your images.
          </p>
        </div>

        <div class="note-grid">
          <div class="note">
            <h3 class="note__title">Canvas, not cloud</h3>
            <p class="note__body">
              Previews and exports are drawn with the browser's Canvas API. The
              export worker runs on your machine, so even large 4× renders do not
              leave the device.
            </p>
          </div>
          <div class="note">
            <h3 class="note__title">Drafts stay close</h3>
            <p class="note__body">
              The current composition is saved to local storage and reflected in
              the URL. Clearing site data removes the draft.
            </p>
          </div>
          <div class="note">
            <h3 class="note__title">Self-hosted type</h3>
            <p class="note__body">
              Every typeface ships with the site as a WOFF2 file. There are no
              third-party font requests at render time.
            </p>
          </div>
          <div class="note">
            <h3 class="note__title">Vector when you need it</h3>
            <p class="note__body">
              SVG export produces a scalable document with real text and shapes,
              while raster exports are available at 1×, 2×, and 4×.
            </p>
          </div>
        </div>
      </section>

      <section class="page-section" id="faq" aria-labelledby="faq-title">
        <div class="section-head">
          <div>
            <p class="page-kicker">Questions</p>
            <h2 class="section-title" id="faq-title">Practical answers.</h2>
          </div>
          <p class="section-note">
            Everything below is true of the current build. There are no paid
            tiers waiting behind the fold.
          </p>
        </div>

        <div class="faq-list">
          {homeFaqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>{faq.question}</summary>
              <div class="faq-body"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>

  <ToolDirectory />
  <Footer />

  <script>
    import { initEditor } from '../components/EditorApp';

    const boot = () => {
      const root = document.getElementById('typeframe-editor');
      if (root) initEditor(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
  </script>
</BaseLayout>
