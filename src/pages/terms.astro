---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Terms of Service — Typeframe';
const pageDescription =
  'The terms that cover use of Typeframe: ownership of your exports, acceptable use, typeface licensing, and the limits of a free static tool.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  url="https://typeframe.pages.dev/terms/"
>
  <main class="page">
    <div class="prose-wrap">
      <header class="prose-header">
        <p class="page-kicker">Legal</p>
        <h1 class="prose-title">Terms of service</h1>
        <p class="page-lead">
          These terms cover the use of Typeframe. They are written to be read,
          not to hide a subscription behind a wall of clauses.
        </p>
        <p class="prose-meta">Effective November 2026</p>
      </header>

      <div class="prose">
        <section>
          <h2>1. Agreement</h2>
          <p>
            By using Typeframe at
            <a href="https://typeframe.pages.dev">typeframe.pages.dev</a>, you
            agree to these terms. If you do not agree, stop using the site.
          </p>
        </section>

        <section>
          <h2>2. What the service is</h2>
          <p>
            Typeframe is a free, browser-based tool for composing text as an
            image. It runs without an account and without a server-side rendering
            queue. The site is provided as-is, and access may change or be
            withdrawn at any time. There is no paid tier and no service-level
            guarantee.
          </p>
        </section>

        <section>
          <h2>3. Your content and exports</h2>
          <p>
            You keep ownership of the text, images, and designs you bring to
            Typeframe, and of the files you export. Typeframe claims no license
            over them, adds no watermark, and requires no attribution.
          </p>
          <p>
            You are responsible for the rights to any text, quotation, photograph,
            or trademark you use in a composition, and for how the resulting image
            is published. Exports may be used commercially, subject to those
            rights and to applicable law.
          </p>
        </section>

        <section>
          <h2>4. Acceptable use</h2>
          <p>You agree not to use Typeframe to:</p>
          <ul>
            <li>Create or distribute unlawful, defamatory, harassing, or hateful material.</li>
            <li>Infringe copyrights, trademarks, or other rights held by third parties.</li>
            <li>Misrepresent an affiliation with Typeframe or with a brand referenced by a theme.</li>
            <li>Attempt to disrupt the site or interfere with other visitors' access to it.</li>
          </ul>
        </section>

        <section>
          <h2>5. Typefaces and names</h2>
          <p>
            Typeframe bundles open-source typefaces, which remain under their
            respective licenses, including the SIL Open Font License. Those
            licenses govern use of the font software itself.
          </p>
          <p>
            Product and publication names referenced by themes or presets — such
            as Apple, X, LinkedIn, Instagram, TikTok, Notion, Obsidian, The
            Economist, and Braun — are trademarks of their owners. Typeframe is an
            independent tool and is not affiliated with or endorsed by them. The
            visual styles are original interpretations, not brand assets.
          </p>
        </section>

        <section>
          <h2>6. No warranty</h2>
          <p>
            Typeframe is provided <strong>“as is”</strong> and
            <strong>“as available”</strong>, without warranties of any kind,
            express or implied. Rendering can differ between browsers, operating
            systems, and font versions. Keep a copy of any composition or export
            that matters to you.
          </p>
        </section>

        <section>
          <h2>7. Limitation of liability</h2>
          <p>
            To the extent permitted by law, Typeframe and its creator are not
            liable for indirect, incidental, or consequential damages arising from
            use of the site, inability to use it, loss of a local draft, or
            reliance on an exported image.
          </p>
        </section>

        <section>
          <h2>8. Changes to these terms</h2>
          <p>
            These terms may be updated as the tool changes. The effective date at
            the top of this page will move when they do. Continuing to use the site
            after a change means you accept the revised terms.
          </p>
        </section>

        <section>
          <h2>9. Contact</h2>
          <p>
            Questions about these terms can be sent to
            <a href="mailto:support@typeframe.pages.dev">support@typeframe.pages.dev</a>
            or through the <a href="/contact/">contact page</a>.
          </p>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
